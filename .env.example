# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (porta 6543)
# Troque [YOUR-PASSWORD] pela senha do banco definida ao criar o projeto.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
# Chave secreta para assinar o login (frase longa e aleatória, mín. 16 caracteres)
AUTH_SECRET="troque-por-uma-chave-longa-e-aleatoria"
